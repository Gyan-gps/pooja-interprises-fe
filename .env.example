# Copy to .env.local (or .env) and fill in real values.
# Never commit real credentials.
# See docs/DEPLOYMENT.md for production guidance.

NODE_ENV=development
NEXT_MONGODB_URL=mongodb://127.0.0.1:27017/pooja-enterprises

# Required for signed session cookies (min 32 characters).
# In production this must NOT look like a placeholder string.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional session lifetime in days (default: 7, max 90)
# SESSION_TTL_DAYS=7

# Used only by `npm run seed:admin` (never commit real values)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-now

# Optional base URL for `npm run verify:api`
# API_BASE_URL=http://localhost:3000

# Client-exposed variables must be prefixed with NEXT_PUBLIC_
# Do not put secrets in NEXT_PUBLIC_* variables.

