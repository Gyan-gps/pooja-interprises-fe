# Copy to .env.local (or .env) and fill in real values.
# Never commit real credentials.

NODE_ENV=development
NEXT_MONGODB_URL=mongodb://127.0.0.1:27017/pooja-enterprises

# Required for signed session cookies (min 32 characters)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional session lifetime in days (default: 7)
# SESSION_TTL_DAYS=7

# Used only by `npm run seed:admin` (never commit real values)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-now

# Client-exposed variables must be prefixed with NEXT_PUBLIC_
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
